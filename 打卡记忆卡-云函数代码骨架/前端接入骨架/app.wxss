/* app.wxss —— 全局基础样式（浅底深字，无外部依赖、无图标字体） */
page {
  --primary: #3a7afe;
  --danger: #e05050;
  --text: #1f2329;
  --muted: #8a9099;
  --line: #e8eaed;
  --surface: #ffffff;
  background: #f4f5f7;
  color: var(--text);
  font-size: 28rpx;
  font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
}

.page {
  padding: 24rpx;
  box-sizing: border-box;
  min-height: 100vh;
}

.card {
  background: var(--surface);
  border: 1rpx solid var(--line);
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.muted {
  color: var(--muted);
  font-size: 24rpx;
}

.err {
  background: #fff1f0;
  color: var(--danger);
  border: 1rpx solid #ffccc7;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 24rpx;
  word-break: break-all;
}

.btn {
  background: var(--primary);
  color: #fff;
  border-radius: 12rpx;
  font-size: 28rpx;
  padding: 18rpx 0;
  margin: 12rpx 0;
  line-height: 1.6;
}

.btn::after {
  border: none;
}

.btn-ghost {
  background: var(--surface);
  color: var(--primary);
  border: 1rpx solid var(--primary);
}

.btn[disabled] {
  opacity: 0.5;
}
