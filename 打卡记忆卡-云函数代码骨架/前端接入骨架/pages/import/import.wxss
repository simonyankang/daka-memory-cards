.tabs {
  display: flex;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.tabs .btn {
  flex: 1;
  margin: 0;
}

.paste-area {
  width: 100%;
  min-height: 300rpx;
  font-size: 26rpx;
  line-height: 1.6;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.summary-row {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #e8eaed;
}

.summary-row:last-child {
  border-bottom: none;
}

.summary-row .strong {
  color: #3a7afe;
  font-weight: 600;
}

.tip {
  font-size: 24rpx;
  line-height: 1.6;
}
