.progress {
  text-align: center;
  margin-bottom: 24rpx;
}

.flashcard {
  min-height: 320rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  text-align: center;
  padding: 48rpx 32rpx;
}

.flashcard .front {
  font-size: 40rpx;
  font-weight: 600;
  line-height: 1.5;
  word-break: break-all;
}

.flashcard .divider {
  width: 100%;
  height: 1rpx;
  background: #e8eaed;
  margin: 32rpx 0;
}

.flashcard .back {
  font-size: 30rpx;
  line-height: 1.6;
  word-break: break-all;
}

.flashcard .hint {
  margin-top: 32rpx;
}

.buttons {
  display: flex;
  gap: 12rpx;
  margin-top: 24rpx;
}

.buttons .btn {
  flex: 1;
  padding: 14rpx 0;
  font-size: 26rpx;
}

.grade-again { background: #e05050; }
.grade-hard  { background: #e29a2f; }
.grade-good  { background: #3a7afe; }
.grade-easy  { background: #2ea36b; }

.summary .section-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.summary-row {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #e8eaed;
}

.summary-row:last-child {
  border-bottom: none;
}

.summary-row .strong {
  font-size: 30rpx;
  min-width: 0;
}
